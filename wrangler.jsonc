{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "google-cloud-text-to-audio",
  "compatibility_date": "2025-01-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
