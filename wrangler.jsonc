{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "google-cloud-text-to-audio",
  "compatibility_date": "2025-01-01",
  "build": {
    "command": "bun run build || npm run build"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
